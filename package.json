{
  "name": "cutfac",
  "version": "0.2.1",
  "description": "Local-first short-form video studio for solo developers. Bring your own agent.",
  "license": "AGPL-3.0-only",
  "homepage": "https://cutfac.com",
  "bugs": {
    "url": "https://github.com/w00ing/cutfac/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w00ing/cutfac.git"
  },
  "author": "Wyverse Labs",
  "bin": {
    "cutfac": "./src/cli.ts"
  },
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "bun --watch src/cli.ts serve",
    "dev:web": "vite",
    "build": "vite build",
    "serve": "bun run src/cli.ts serve",
    "mcp": "bun run src/cli.ts mcp",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:electron": "bun build ./electron/main.ts --target node --format esm --external electron --outfile dist/electron/main.js && bun build ./electron/preload.ts --target node --format cjs --external electron --outfile dist/electron/preload.cjs",
    "build:sidecar": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/cli.ts --outfile dist/sidecar/cutfac && codesign --force --sign - dist/sidecar/cutfac",
    "desktop": "bun run build && bun run build:electron && electron .",
    "desktop:dev": "bun electron/dev.ts",
    "dist:desktop": "bun run build && bun run build:sidecar && bun run build:electron && electron-builder --mac dir -c.mac.identity=null",
    "check:agents": "bun electron/checkAgents.ts",
    "release": "bun --env-file=.env.release electron/release.ts",
    "lint": "oxlint src web/src test electron",
    "format": "oxfmt --write src web/src test electron",
    "format:check": "oxfmt --check src web/src test electron",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.3",
    "effect": "4.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@effect/tsgo": "0.51.1",
    "@oxlint/plugins": "1.87.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@shadcn/lint": "0.2.1",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.55.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "20.1.4",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.3",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  },
  "trustedDependencies": [
    "electron"
  ]
}
