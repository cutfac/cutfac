{
  "name": "content-factory",
  "version": "0.1.0",
  "description": "Local-first short-form content factory for solo developers. Bring your own agent.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "factory": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts serve --dev",
    "dev:web": "vite",
    "build": "vite build",
    "serve": "bun run src/cli.ts serve",
    "mcp": "bun run src/cli.ts mcp",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src web/src test",
    "format": "oxfmt --write src web/src test",
    "format:check": "oxfmt --check src web/src test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
